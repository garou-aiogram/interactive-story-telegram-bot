# Скопируй в .env и заполни: cp .env.example .env
# .env в git не попадает (см. .gitignore).

# ---- Telegram ----
BOT_TOKEN=123456:ABC-токен_от_BotFather

# ---- LLM ----
# Локально (llama-server / LM Studio).
# Порт по умолчанию: llama-server 8080, LM Studio 1234.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=sk-no-key-required
LLM_MODEL=local-model

# Облако (Gemini), если нужно — раскомментируй и закомментируй блок выше:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=ключ_из_Google_AI_Studio
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_LOCAL=false

TEMPERATURE=0.85
TOP_P=0.92
MAX_TOKENS=700
REQUEST_TIMEOUT=180
STREAM=true

# ---- Переключение бэкенда ----
# true  -> llama-server / LM Studio (подмешивает отключение thinking у Gemma 4)
# false -> облачный провайдер (Gemini, Groq, OpenRouter)
LLM_LOCAL=true

# Системный HTTP_PROXY перехватывает даже запросы на 127.0.0.1 и отдаёт 502.
# Для локального сервера держи false.
TRUST_ENV=false

# ---- Нагрузка ----
# Одновременных генераций. Должно быть <= --parallel у llama-server.
MAX_CONCURRENT=4

# ---- Контекст ----
KEEP_RECENT_TURNS=8
SUMMARIZE_AFTER=12
SUMMARY_MAX_TOKENS=400

# ---- Прочее ----
DB_PATH=story_bot.db
DEFAULT_LANG=en

# ---- Админка ----
# Свой Telegram ID узнать у @userinfobot. Через запятую, если несколько.
ADMIN_IDS=123456789
# Сообщений в секунду при рассылке. Потолок Telegram ~30, держи ниже.
BROADCAST_RATE=20
